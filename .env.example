# Postgres (Neon). Omit to use an embedded local database in ./.pglite for development.
DATABASE_URL=
# Anthropic API key. Omit to use deterministic fallback drafting (no AI calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 32+ random characters; signs session cookies.
SESSION_SECRET=
# Comma-separated emails granted the reviewer role on sign-in.
REVIEWER_EMAILS=
# Email delivery for sign-in links. Omit to print links to the server log.
RESEND_API_KEY=
MAIL_FROM=Plainfirm <no-reply@plainfirm.com>
APP_URL=http://localhost:3000
# Comma-separated emails granted the admin role on sign-in.
ADMIN_EMAILS=
# Master key wrapping each client's data key: 32 random bytes, base64. `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
