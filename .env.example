# Postgres (Neon). Omit to use an embedded local database in ./.pglite for development.
DATABASE_URL=
# Anthropic API key. Omit to use deterministic fallback drafting (no AI calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# 32+ random characters; signs session cookies.
SESSION_SECRET=
# Comma-separated emails granted the reviewer role on sign-in.
REVIEWER_EMAILS=
# Email delivery for sign-in links. Omit to print links to the server log.
RESEND_API_KEY=
MAIL_FROM=easier.company <no-reply@easier.company>
APP_URL=http://localhost:3000
# Comma-separated emails granted the admin role on sign-in.
ADMIN_EMAILS=
# Master key wrapping each client's data key: 32 random bytes, base64. `openssl rand -base64 32`
DATA_ENCRYPTION_KEY=
# Comma-separated emails allowed to sign in before launch (pilot clients).
ACCESS_EMAILS=
# The licensed preparer named in the engagement letter and IRC 7216 consent, e.g. "Jane Doe, EA".
# Changing it changes the consent text, so clients must accept again.
PREPARER_OF_RECORD=
# Fund that receives Labor Pledge contributions.
PLEDGE_RECIPIENT=
